<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <body>
      <div class="container pt-4">
        <div class="row">
          <div class="col-md-4">
            <div class="container pt-4">
              <div class="d-flex gap-3">

                <!-- Thu nhập -->
                <div
                  class="bg-light rounded-4 shadow flex-shrink-0 d-flex flex-column justify-content-center align-items-center"
                  style="
        width: 280px;
        height: 150px;
        background-color: #e9ecef !important;
        border: 1px solid #d6d8db;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12) !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      "
                >
                  <small class="text-secondary mb-1 fw-medium">Thu nhập</small>
                  <h1 class="m-0 text-success fw-bold">{{income}}</h1>
                </div>
                <div
                  class="bg-light rounded-4 shadow flex-shrink-0 d-flex flex-column justify-content-center align-items-center"
                  style="
        width: 280px;
        height: 150px;
        background-color: #e9ecef !important;
        border: 1px solid #d6d8db;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12) !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      "
                >
                  <small class="text-secondary mb-1 fw-medium">Chi tiêu</small>
                  <h1 class="m-0 text-danger fw-bold">{{expense}}</h1>
                </div>

                <div
                {{#each userData}}
                  class="bg-light rounded-4 shadow flex-shrink-0 d-flex flex-column justify-content-center align-items-center"
                  style="
        width: 280px;
        height: 150px;
        background-color: #e9ecef !important;
        border: 1px solid #d6d8db;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12) !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      "
                >
                  <small class="text-secondary mb-1 fw-medium">Còn lại</small>
                  <h1 class="m-0 fw-bold">{{this.balance}}</h1>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <div class="container py-4">
      <div class="card shadow-sm border-0">
        <div class="card-body">

          <h4 class="mb-3">
            Giao dịch gần đây
          </h4>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Loại</th>
                  <th>Danh mục</th>
                  <th>Mô tả</th>
                  <th>Số tiền</th>
                  <th>Ngày</th>
                </tr>
              </thead>
              <tbody>
                {{#each TransactionData}}
                  <tr>
                    <td>
                      {{#if (eq this.type "income")}}
                        <span class="badge text-bg-success">
                          Thu nhập
                        </span>
                      {{else}}
                        <span class="badge text-bg-danger">
                          Chi tiêu
                        </span>
                      {{/if}}
                    </td>
                    <td>
                      {{this.category}}
                    </td>
                    <td>
                      {{this.description}}
                    </td>
                    <td class="fw-semibold">
                      {{this.amount}}
                      ₫
                    </td>
                    <td>
                      {{this.date}}
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    </div>
    </body>
  </body>
</html>